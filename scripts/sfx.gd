extends Node
## Autoload. Plays sound effects (flat or positioned in 3D) and music, on
## "SFX" and "Music" buses whose volumes come from Settings. The sounds are
## generated by tools/make_audio.py.

const EFFECTS := [
	"engine", "drift", "boost", "item_get", "roulette", "missile", "hit", "oil", "shield",
	"storm", "bump", "land", "pad", "beep", "go", "lap", "finish", "click",
]
## Per-sound loudness trim (dB), so square-wave beeps don't drown everything.
const TRIM := {"beep": -10.0, "go": -10.0, "item_get": -9.0, "roulette": -14.0, "click": -8.0, "lap": -4.0, "finish": -4.0, "pad": -6.0}

var _streams := {}
var _pool: Array[AudioStreamPlayer] = []
var _pool_3d: Array[AudioStreamPlayer3D] = []
var _music: AudioStreamPlayer
var _music_name := ""


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	# The Music and SFX buses are defined in default_bus_layout.tres. They must
	# exist at startup: in browsers, buses added while running get no sound.
	_ensure_bus("Music")
	_ensure_bus("SFX")
	for n in EFFECTS:
		var path := "res://audio/%s.wav" % n
		if ResourceLoader.exists(path):
			_streams[n] = load(path)
	for n in ["music_menu", "music_race"]:
		var path := "res://audio/%s.ogg" % n
		if ResourceLoader.exists(path):
			_streams[n] = load(path)
	for i in 8:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool.append(p)
	for i in 10:
		var p := AudioStreamPlayer3D.new()
		p.bus = "SFX"
		p.unit_size = 12.0
		p.max_distance = 140.0
		add_child(p)
		_pool_3d.append(p)
	_music = AudioStreamPlayer.new()
	_music.bus = "Music"
	add_child(_music)
	apply_volumes()


func apply_volumes() -> void:
	_set_bus_volume("Music", Game.music_volume)
	_set_bus_volume("SFX", Game.sfx_volume)


## Plays a sound at full volume wherever the listener is (UI, HUD, player).
func play(sound: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	if not _streams.has(sound):
		return
	var p: AudioStreamPlayer = _free_player(_pool)
	p.stream = _streams[sound]
	p.volume_db = volume_db + TRIM.get(sound, 0.0)
	p.pitch_scale = pitch
	p.play()


## Plays a sound at a position in the world, so it fades with distance.
func play_at(sound: String, at: Vector3, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	if not _streams.has(sound):
		return
	var p: AudioStreamPlayer3D = _free_player(_pool_3d)
	p.stream = _streams[sound]
	p.volume_db = volume_db + TRIM.get(sound, 0.0)
	p.pitch_scale = pitch
	p.global_position = at
	p.play()


## A looping sound attached to a kart (engine, drift squeal).
func make_kart_loop(kart: Node3D, sound: String, volume_db: float) -> AudioStreamPlayer3D:
	var p := AudioStreamPlayer3D.new()
	p.stream = _streams.get(sound)
	p.bus = "SFX"
	p.volume_db = volume_db
	p.unit_size = 10.0
	p.max_distance = 90.0
	p.autoplay = sound == "engine"
	kart.add_child(p)
	return p


func play_music(track: String) -> void:
	if _music_name == track and _music.playing:
		return
	_music_name = track
	_music.stream = _streams.get(track)
	if _music.stream:
		_music.play()


func stop_music() -> void:
	_music_name = ""
	_music.stop()


func _free_player(pool: Array):
	for p in pool:
		if not p.playing:
			return p
	return pool[0]


func _ensure_bus(bus_name: String) -> void:
	if AudioServer.get_bus_index(bus_name) != -1:
		return
	AudioServer.add_bus()
	var idx := AudioServer.bus_count - 1
	AudioServer.set_bus_name(idx, bus_name)
	AudioServer.set_bus_send(idx, "Master")


func _set_bus_volume(bus_name: String, level: float) -> void:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx == -1:
		return
	AudioServer.set_bus_mute(idx, level <= 0.001)
	AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(level, 0.001)))
