extends SceneTree
## Writes server/src/tracks.js: the start point and checkpoints of every
## track, which the server uses to check uploaded time trial runs.
## Run after changing tracks.gd:
##   godot --headless --path . --script res://tools/export_tracks.gd

const TOP_SPEED := 42.0   ## Faster than any kart can go, even boosting


func _initialize() -> void:
	var Track = load("res://scripts/track.gd")
	var Tracks = load("res://scripts/tracks.gd")
	var out := {}
	for d in Tracks.LIST:
		var t = Track.new()
		t.track_id = d.id
		root.add_child(t)
		t.build()
		var start: Vector3 = t.point_at(0.0)
		out[d.id] = {
			"name": d.name,
			"length": snappedf(t.length, 0.1),
			"start": [snappedf(start.x, 0.1), snappedf(start.z, 0.1)],
			"checkpoints": t.checkpoints(16),
			"min_time": snappedf(t.length * 3.0 * 0.92 / TOP_SPEED, 0.1),
		}
		t.free()
	var js := "// Generated by tools/export_tracks.gd. Do not edit by hand.\nexport default " + JSON.stringify(out, "  ") + ";\n"
	var f := FileAccess.open("res://server/src/tracks.js", FileAccess.WRITE)
	f.store_string(js)
	f.close()
	print("wrote server/src/tracks.js for ", out.keys())
	quit()
